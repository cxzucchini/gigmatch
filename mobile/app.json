{
  "expo": {
    "name": "Gigmatch",
    "slug": "gigmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gigmatch",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "apiUrl": "https://gigmatch-orcin.vercel.app/api",
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "39945a0a-478a-463a-a393-c5651a4278b0"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {}
      ],
      [
        "expo-document-picker",
        {}
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EFE9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gigmatch.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
